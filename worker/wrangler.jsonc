{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkthat-api",
  "account_id": "50dd4774d52e63447a7526cff496e9b8",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Used unless an OPENAI_API_KEY secret is added, which switches the provider.
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "OPENAI_API_URL": "https://genai-sharedservice-americas.pwcinternal.com/v1/chat/completions",
    "OPENAI_MODEL": "azure.gpt-4.1-nano"
  }
}
