{
  "name": "sow-fact-check",
  "private": true,
  "workspaces": [
    "client",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -n worker,client -c blue,green \"npm run dev -w worker\" \"npm run dev -w client\"",
    "worker:dev": "npm run dev -w worker",
    "worker:deploy": "npm run deploy -w worker"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
