{
  "name": "checkthat",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "server:dev": "npm run dev -w server",
    "worker:deploy": "npm run deploy -w worker"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
